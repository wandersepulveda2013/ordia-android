<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta compacta de sugerencia externa mostrada por el guardián flotante -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/ordia_candidate_background"
    android:elevation="8dp">

    <!-- Tipo de intención + Fecha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/card_suggestion_kind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="11sp"
            android:textColor="#D9BC7A"
            android:text="@string/suggestion_type_task" />

        <TextView
            android:id="@+id/card_suggestion_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="#888888"
            android:text="@string/suggestion_no_date" />
    </LinearLayout>

    <!-- Título interpretado -->
    <TextView
        android:id="@+id/card_suggestion_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:lineSpacingExtra="2dp"
        android:paddingBottom="6dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- Origen -->
    <TextView
        android:id="@+id/card_suggestion_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#666666"
        android:paddingBottom="10dp" />

    <!-- Confianza (solo diagnóstico, oculto por defecto) -->
    <TextView
        android:id="@+id/card_suggestion_confidence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="10sp"
        android:textColor="#555555"
        android:visibility="gone" />

    <!-- Acciones principales (máx 4) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:weightSum="4">

        <Button
            android:id="@+id/card_action_add"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/external_suggestion_add"
            android:textSize="12sp"
            android:padding="2dp"
            android:layout_marginEnd="3dp"
            style="@style/OrdiaCandidateButton" />

        <Button
            android:id="@+id/card_action_edit"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/external_suggestion_edit"
            android:textSize="12sp"
            android:padding="2dp"
            android:layout_marginEnd="3dp"
            style="@style/OrdiaCandidateButton" />

        <Button
            android:id="@+id/card_action_postpone"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/external_suggestion_postpone"
            android:textSize="12sp"
            android:padding="2dp"
            android:layout_marginEnd="3dp"
            style="@style/OrdiaCandidateButton" />

        <Button
            android:id="@+id/card_action_ignore"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:text="@string/external_suggestion_ignore"
            android:textSize="12sp"
            android:padding="2dp"
            style="@style/OrdiaCandidateButton" />
    </LinearLayout>
</LinearLayout>
