<?xml version="1.0" encoding="utf-8"?>
<!-- Vista completa del teclado Ordía 3 con barra de candidatos -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="bottom">

    <!-- Consentimiento por aplicación: el análisis empieza desactivado. -->
    <LinearLayout
        android:id="@+id/analysis_permission_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:background="#121225">

        <TextView
            android:id="@+id/analysis_permission_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/analysis_permission_button"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="88dp"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Barra de candidatos (inicialmente oculta) -->
    <FrameLayout
        android:id="@+id/candidate_bar_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:clipChildren="false">

        <!-- Tarjeta de sugerencia contextual -->
        <LinearLayout
            android:id="@+id/suggestion_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp"
            android:background="@drawable/ordia_candidate_background"
            android:elevation="6dp">

            <!-- Indicador de análisis activo -->
            <LinearLayout
                android:id="@+id/analysis_indicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="4dp"
                android:visibility="gone">
                <TextView
                    android:id="@+id/analysis_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/keyboard_analyzing"
                    android:textSize="13sp"
                    android:textColor="#888888" />
                <ProgressBar
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    style="?android:attr/progressBarStyleSmall"
                    android:indeterminate="true" />
            </LinearLayout>

            <!-- Texto principal de sugerencia -->
            <TextView
                android:id="@+id/suggestion_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textColor="#FFFFFF"
                android:lineSpacingExtra="2dp"
                android:text=""
                android:paddingBottom="8dp" />

            <!-- Acciones de la sugerencia -->
            <LinearLayout
                android:id="@+id/suggestion_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone">

                <Button
                    android:id="@+id/action_add"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/keyboard_suggestion_add"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    style="@style/OrdiaCandidateButton" />

                <Button
                    android:id="@+id/action_edit"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/keyboard_suggestion_edit"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    style="@style/OrdiaCandidateButton" />

                <Button
                    android:id="@+id/action_remind_later"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/keyboard_suggestion_remind_short"
                    android:textSize="13sp"
                    android:padding="4dp"
                    android:layout_marginEnd="4dp"
                    style="@style/OrdiaCandidateButton" />

                <ImageButton
                    android:id="@+id/action_ignore"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/keyboard_suggestion_ignore"
                    android:scaleType="centerInside"
                    android:padding="6dp" />
            </LinearLayout>

            <!-- Barra de herramientas inferior -->
            <LinearLayout
                android:id="@+id/candidate_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp">

                <ImageButton
                    android:id="@+id/action_guardian"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_menu_myplaces"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/keyboard_guardian"
                    android:scaleType="centerInside"
                    android:padding="4dp" />

                <ImageButton
                    android:id="@+id/action_privacy"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_lock_lock"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/keyboard_privacy"
                    android:scaleType="centerInside"
                    android:padding="4dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dont_detect_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:text="@string/keyboard_dont_detect_similar"
                    android:textSize="11sp"
                    android:textColor="#888888"
                    android:padding="4dp"
                    android:background="?android:attr/selectableItemBackground" />

                <ImageButton
                    android:id="@+id/action_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@android:drawable/ic_media_pause"
                    android:background="?android:attr/selectableItemBackground"
                    android:contentDescription="@string/keyboard_pause_1h"
                    android:scaleType="centerInside"
                    android:padding="4dp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Teclado QWERTY -->
    <android.inputmethodservice.KeyboardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:keyBackground="@drawable/ordia_keyboard_key"
        android:keyTextColor="@android:color/white"
        android:keyTextSize="18sp"
        android:labelTextSize="12sp"
        android:background="#1A1A2E"
        android:shadowColor="@android:color/black"
        android:shadowRadius="1.0" />

</LinearLayout>
