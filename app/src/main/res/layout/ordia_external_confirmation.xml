<?xml version="1.0" encoding="utf-8"?>
<!-- Actividad compacta y translúcida para editar sugerencia externa.
     ButtonStyle: los botones del pie son FILLED a propósito (overlay oscuro con
     acento dorado; diseño propio, no una button bar de Material). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:layout_gravity="center"
    android:background="@drawable/ordia_candidate_background"
    android:padding="20dp"
    android:elevation="12dp"
    tools:ignore="ButtonStyle">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/external_suggestion_edit_title"
        android:textSize="16sp"
        android:textColor="#FFFFFF"
        android:paddingBottom="16dp" />

    <!-- Tipo de intención -->
    <TextView
        android:id="@+id/confirmation_kind"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#888888"
        android:paddingBottom="4dp" />

    <!-- Fecha -->
    <TextView
        android:id="@+id/confirmation_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#AAAAAA"
        android:paddingBottom="12dp" />

    <!-- Título interpretado -->
    <TextView
        android:id="@+id/confirmation_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="#FFFFFF"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <!-- Campo editable: título efímero de la sugerencia; NO es dato autofillable
         (ni usuario, ni email, ni contraseña) → importanteForAutofill="no". -->
    <EditText
        android:id="@+id/confirmation_input_title"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#3A3A5E"
        android:textColor="#FFFFFF"
        android:textColorHint="#888888"
        android:hint="@string/external_suggestion_title_hint"
        android:padding="8dp"
        android:gravity="start"
        android:singleLine="true"
        android:inputType="text"
        android:importantForAutofill="no" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:paddingTop="16dp">

        <Button
            android:id="@+id/confirmation_btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/external_suggestion_cancel"
            android:textSize="13sp"
            android:background="#3A3A5E"
            android:textColor="#FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/confirmation_btn_save"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/external_suggestion_save"
            android:textSize="13sp"
            android:background="#8A6A2F"
            android:textColor="#FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp" />
    </LinearLayout>
</LinearLayout>
