<?xml version="1.0" encoding="utf-8"?>
<!-- Configuración del servicio de accesibilidad para captura de pantalla avanzada.
     Todo desactivado inicialmente. Requiere consentimiento explícito del usuario
     y autorización por aplicación. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewTextChanged|typeWindowStateChanged|typeViewClicked"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="500" />
